<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 192 192" width="192" height="192">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#121318" />
      <stop offset="100%" stop-color="#1c1e24" />
    </linearGradient>
    <linearGradient id="hat" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#475569" />
      <stop offset="100%" stop-color="#334155" />
    </linearGradient>
  </defs>

  <!-- Fondo oscuro idéntico al panel del juego -->
  <rect width="192" height="192" rx="40" fill="url(#bg)" />

  <!-- Detective / Espía -->
  <g transform="translate(96, 96)">
    <!-- Cabeza -->
    <circle cx="0" cy="5" r="22" fill="#fbcfe8" />
    
    <!-- Sombrero de Detective -->
    <ellipse cx="0" cy="-12" rx="38" ry="8" fill="url(#hat)" />
    <path d="M-22 -12 C-22 -32 22 -32 22 -12 Z" fill="url(#hat)" />
    <!-- Cinta del sombrero (Rojo Impostor) -->
    <rect x="-22" y="-16" width="44" height="5" fill="#ef4444" rx="1" />

    <!-- Gafas de Sol / Sombras -->
    <ellipse cx="-9" cy="0" rx="8" ry="5" fill="#0f172a" />
    <ellipse cx="9" cy="0" rx="8" ry="5" fill="#0f172a" />
    <rect x="-3" y="-2" width="6" height="2" fill="#0f172a" />

    <!-- Lupa de Espía (Lado Derecho) -->
    <g transform="translate(18, 12) rotate(-25)">
      <circle cx="0" cy="0" r="12" stroke="#38bdf8" stroke-width="4" fill="rgba(56, 189, 248, 0.2)" />
      <rect x="-2" y="12" width="4" height="14" rx="2" fill="#94a3b8" />
    </g>
  </g>
</svg>