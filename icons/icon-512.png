<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="bg512" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#121318" />
      <stop offset="100%" stop-color="#1c1e24" />
    </linearGradient>
    <linearGradient id="hat512" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#475569" />
      <stop offset="100%" stop-color="#334155" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="8" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <rect width="512" height="512" rx="100" fill="url(#bg512)" />

  <g transform="translate(256, 256) scale(2.6)">
    <!-- Cabeza -->
    <circle cx="0" cy="5" r="22" fill="#fbcfe8" />
    
    <!-- Sombrero -->
    <ellipse cx="0" cy="-12" rx="38" ry="8" fill="url(#hat512)" />
    <path d="M-22 -12 C-22 -32 22 -32 22 -12 Z" fill="url(#hat512)" />
    <rect x="-22" y="-16" width="44" height="5" fill="#ef4444" rx="1" />

    <!-- Gafas de Sol -->
    <ellipse cx="-9" cy="0" rx="8" ry="5" fill="#0f172a" />
    <ellipse cx="9" cy="0" rx="8" ry="5" fill="#0f172a" />
    <rect x="-3" y="-2" width="6" height="2" fill="#0f172a" />

    <!-- Lupa brillante -->
    <g transform="translate(18, 12) rotate(-25)" filter="url(#glow)">
      <circle cx="0" cy="0" r="12" stroke="#38bdf8" stroke-width="4" fill="rgba(56, 189, 248, 0.25)" />
      <rect x="-2" y="12" width="4" height="14" rx="2" fill="#94a3b8" />
    </g>
  </g>
</svg>